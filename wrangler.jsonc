{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luana-english-school",
  "main": "worker.js",
  "compatibility_date": "2026-07-08",
  "routes": [
    {
      "pattern": "luanaenglishschool.jp",
      "custom_domain": true
    },
    {
      "pattern": "www.luanaenglishschool.jp",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "LOGIN_FROM_EMAIL": "Luana English School <portal@luanaenglishschool.jp>"
  },
  "secrets": {
    "required": [
      "SESSION_SECRET",
      "STAFF_PORTAL_PASSWORD",
      "SUMMER_WEEK_1_CODE",
      "SUMMER_WEEK_2_CODE",
      "SUMMER_WEEK_3_CODE"
    ]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luana_parent_portal",
      "database_id": "90df8f89-990a-46cc-803f-9c1cfc86682d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "luana-parent-photos"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "env": {
    "staging": {
      "name": "luana-english-school-staging",
      "routes": [],
      "workers_dev": true,
      "vars": {
        "LOGIN_FROM_EMAIL": "Luana English School <portal@luanaenglishschool.jp>"
      },
      "secrets": {
        "required": [
          "SESSION_SECRET",
          "STAFF_PORTAL_PASSWORD",
          "SUMMER_WEEK_1_CODE",
          "SUMMER_WEEK_2_CODE",
          "SUMMER_WEEK_3_CODE"
        ]
      },
      "assets": {
        "directory": ".",
        "binding": "ASSETS"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "luana_parent_portal_staging",
          "database_id": "38117423-b2c3-4e88-896d-41736ff15feb"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PHOTOS",
          "bucket_name": "luana-parent-photos-staging"
        }
      ],
      "images": {
        "binding": "IMAGES"
      }
    }
  }
}
